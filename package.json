{
  "name": "vgram",
  "version": "1.0.0",
  "description": "Runable Nest starter repository",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "runable prepare",
    "build": "nest build",
    "postbuild": "runable build",
    "postbuild0": "tsc -p tsconfig.runable.build.json && runable build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typeorm": "tsx --tsconfig tsconfig.server.json node_modules/typeorm/cli.js -d src/data-source.ts",
    "typeorm0": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "pnpm typeorm migration:generate",
    "migration:run": "pnpm typeorm migration:run"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.2",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.46.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/typeorm": "^12.0.2",
    "@runablejs/tailwindcss": "^0.1.0",
    "@unovis/vue": "^1.7.0",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "lodash-es": "^4.18.1",
    "mysql2": "^3.24.5",
    "ofetch": "^1.5.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "reka-ui": "^2.10.4",
    "runable": "^1.2.1",
    "rxjs": "^7.8.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typeorm": "^1.1.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.43",
    "vue-input-otp": "^0.4.0",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@runablejs/cli": "^1.2.1",
    "@types/express": "^5.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^18.0.5",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
